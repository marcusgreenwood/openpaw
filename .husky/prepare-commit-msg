#!/usr/bin/env sh
# Auto-fixes commit subjects that can be mechanically normalized, before
# commitlint validates them in the commit-msg hook. See CONTRIBUTING.md.
# Bypass with SKIP_COMMIT_LINT=1 or `git commit --no-verify`.

# Never hard-block a contributor whose toolchain is missing Node.
command -v node >/dev/null 2>&1 || exit 0

node "$(dirname "$0")/../scripts/normalize-commit-msg.mjs" "$1" "$2" || exit 0
