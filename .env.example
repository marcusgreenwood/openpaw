# OpenPaw environment variables
#
# Copy this file to `.env.local` (or `.env`) and fill in what you need.
# Everything is optional except at least one AI provider key.
#
# Environment variables ALWAYS take precedence over values saved in the
# Settings UI (which are stored in .claw/*.json).
#
# Full reference: docs/configuration.md

# ---------------------------------------------------------------------------
# AI providers — at least one is required for chat to work.
# Only configured providers appear in the model selector.
# ---------------------------------------------------------------------------

ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_GENERATIVE_AI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXX
MOONSHOT_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Memory (Minns) — optional. https://minns.ai
# Setting MINNS_API_KEY is what enables the memory layer.
# ---------------------------------------------------------------------------

# MINNS_API_KEY=minns_xxxxxxxxxxxxxxxxxxxxxxxx
# MINNS_PROJECT_ID=proj_xxxxxxxx

# ---------------------------------------------------------------------------
# Channels — all optional. A channel is enabled when its token is set.
# Webhook URLs are shown in Settings → Channels.
# ---------------------------------------------------------------------------

# Telegram — create a bot via @BotFather.
# Without TELEGRAM_WEBHOOK_SECRET, incoming webhooks are NOT verified.
# TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TELEGRAM_WEBHOOK_SECRET=some-long-random-string

# WhatsApp Cloud API (Meta Business Platform).
# WHATSAPP_VERIFY_TOKEN is your own string, echoed back during the webhook handshake.
# WHATSAPP_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxx
# WHATSAPP_VERIFY_TOKEN=some-long-random-string
# WHATSAPP_PHONE_NUMBER_ID=123456789012345

# Slack — registers the Chat SDK Slack adapter when the bot token is present.
# SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxx-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx
# SLACK_SIGNING_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Discord — registers the Chat SDK Discord adapter when the bot token is present.
# DISCORD_BOT_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx.xxxxxx.xxxxxxxxxxxxxxxxxxxxxxxxxxx
# DISCORD_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Chat — surfaced in the Channels UI only. No adapter is registered in
# lib/bot.ts, so /api/webhooks/gchat returns 404 until one is added.
# GOOGLE_CHAT_SERVICE_ACCOUNT_KEY={"type":"service_account",...}
# GOOGLE_CHAT_PROJECT_ID=my-gcp-project

# ---------------------------------------------------------------------------
# Workspace — the directory the agent reads, writes, and runs commands in.
# Defaults to <project>/workspace.
# ---------------------------------------------------------------------------

# CLAW_WORKSPACE_DIR=/absolute/path/to/workspace

# ---------------------------------------------------------------------------
# Timeouts and limits (milliseconds unless noted). Defaults shown.
# ---------------------------------------------------------------------------

# Max runtime for one executeBash call.
# CLAW_BASH_TIMEOUT_MS=30000

# Max runtime for one executeCode snippet.
# CLAW_CODE_EXEC_TIMEOUT_MS=15000

# Max runtime for `npx skills add`.
# CLAW_SKILL_INSTALL_TIMEOUT_MS=60000

# Declared for streaming chat; the streaming route currently relies on its own
# maxDuration of 120s instead.
# CLAW_CHAT_STREAM_TIMEOUT_MS=120000

# Hard timeout for blocking (webhook) chat requests.
# CLAW_CHAT_BLOCKING_TIMEOUT_MS=90000

# Default cap on agentic tool steps (a request's maxToolSteps overrides it).
# CLAW_MAX_TOOL_STEPS=15

# ---------------------------------------------------------------------------
# Python sandbox — explicit interpreter used to create <workspace>/.venv.
# Tried before the Homebrew python@3.14 paths and /usr/local/bin/python3.
# ---------------------------------------------------------------------------

# OPENPAW_PYTHON_PATH=/opt/homebrew/opt/python@3.14/bin/python3

# ---------------------------------------------------------------------------
# Set by the hosting platform — you normally do not set these yourself.
# Used to build the base URL the cron runner posts notifications to.
# ---------------------------------------------------------------------------

# VERCEL_URL=my-app.vercel.app
# PORT=3000
