# OpenPaw environment variables — copy to `.env` and fill in what you need.
#
# Everything here is optional except one AI provider key.
# Environment variables ALWAYS take precedence over values saved in the
# Settings UI (which are stored as JSON under .claw/).
#
# Full reference: docs/configuration.md

# ---------------------------------------------------------------------------
# AI providers — at least one required
# ---------------------------------------------------------------------------
# Only providers with a configured key appear in the model selector.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
MOONSHOT_API_KEY=

# ---------------------------------------------------------------------------
# Workspace & runtime
# ---------------------------------------------------------------------------

# Default working directory for file ops, bash commands, and crons.
# Read once at startup; restart to apply changes. Default: <project>/workspace
CLAW_WORKSPACE_DIR=

# Explicit Python interpreter for the workspace virtualenv. Tried before the
# Homebrew / /usr/local fallbacks.
OPENPAW_PYTHON_PATH=

# Only used to build the base URL for cron notifications when VERCEL_URL is
# unset. Does NOT change the port Next.js binds to — use `next dev -p` for that.
# Default: 3000
PORT=

# Set automatically on Vercel. Used as https://$VERCEL_URL for the cron
# notification callback. Leave unset locally.
VERCEL_URL=

# ---------------------------------------------------------------------------
# Timeouts & limits (milliseconds, except CLAW_MAX_TOOL_STEPS)
# ---------------------------------------------------------------------------
# Unparseable values fall back to the defaults shown.

# CLAW_BASH_TIMEOUT_MS=30000
# CLAW_CODE_EXEC_TIMEOUT_MS=15000
# CLAW_SKILL_INSTALL_TIMEOUT_MS=60000
# CLAW_CHAT_STREAM_TIMEOUT_MS=120000
# CLAW_CHAT_BLOCKING_TIMEOUT_MS=90000
# CLAW_MAX_TOOL_STEPS=15

# ---------------------------------------------------------------------------
# Channels — Telegram (custom webhook integration)
# ---------------------------------------------------------------------------
# Token from @BotFather. Register the webhook with:
#   curl "https://api.telegram.org/bot<TOKEN>/setWebhook" \
#     -d "url=https://<DOMAIN>/api/webhooks/telegram" \
#     -d "secret_token=<WEBHOOK_SECRET>"

TELEGRAM_BOT_TOKEN=

# Strongly recommended: without it, the webhook accepts any request.
TELEGRAM_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Channels — Slack and Discord (Chat SDK adapters)
# ---------------------------------------------------------------------------
# These MUST be set as environment variables. lib/bot.ts registers the adapters
# at module load based on the token vars below; saving them in the Settings UI
# updates the status display but does not enable the webhook. Restart after
# setting them.

SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=

# ---------------------------------------------------------------------------
# Channels — Google Chat (status display only)
# ---------------------------------------------------------------------------
# No Google Chat adapter is registered, so /api/webhooks/gchat returns 404.
# These only populate the Channels UI.

GOOGLE_CHAT_SERVICE_ACCOUNT_KEY=
GOOGLE_CHAT_PROJECT_ID=

# ---------------------------------------------------------------------------
# Channels — WhatsApp (Meta Cloud API)
# ---------------------------------------------------------------------------
# Note: the POST webhook does not verify X-Hub-Signature-256.

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Your own string, echoed back during Meta's subscription handshake.
WHATSAPP_VERIFY_TOKEN=

# ---------------------------------------------------------------------------
# Memory — Minns (optional)
# ---------------------------------------------------------------------------
# If MINNS_API_KEY is set, .claw/minns-config.json is not read at all — export
# MINNS_PROJECT_ID too, or the stored project ID is ignored. Loaded once per
# process; restart after changing.

MINNS_API_KEY=
MINNS_PROJECT_ID=
