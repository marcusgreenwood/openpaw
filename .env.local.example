# ─── AI Provider Keys (at least one required) ───
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_GENERATIVE_AI_API_KEY=AIza...
MOONSHOT_API_KEY=sk-...

# ─── Telegram Bot ───
# Create a bot via @BotFather, then register the webhook:
#   curl https://api.telegram.org/bot<TOKEN>/setWebhook \
#     -d url=https://<YOUR_DOMAIN>/api/webhooks/telegram \
#     -d secret_token=<SECRET>
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# ─── Slack (Chat SDK) ───
# Create app at https://api.slack.com/apps
# Webhook URL: https://<DOMAIN>/api/webhooks/slack
# Subscribe to: app_mention, message.im, message.channels
# Scopes: app_mentions:read, channels:history, channels:read, chat:write,
#          im:history, im:read, reactions:read, reactions:write, users:read
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=

# ─── Discord (Chat SDK) ───
# Create bot at https://discord.com/developers/applications
# Webhook URL: https://<DOMAIN>/api/webhooks/discord
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=

# ─── Google Chat (Chat SDK) ───
# Set up in Google Cloud Console → Chat API
# Webhook URL: https://<DOMAIN>/api/webhooks/gchat
# GOOGLE_CHAT_SERVICE_ACCOUNT_KEY=
# GOOGLE_CHAT_PROJECT_ID=

# ─── WhatsApp (Meta Cloud API — Custom Integration) ───
# Create app at https://developers.facebook.com
# Add WhatsApp product, configure webhook: https://<DOMAIN>/api/webhooks/whatsapp
# Subscribe to: messages
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=my-custom-verify-token
WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_APP_SECRET is NOT read by any code today. lib/chat/verify.ts exports
# verifyWhatsApp(), but nothing calls it and getWhatsAppConfig() never reads this
# variable, so setting it has no effect. Left commented until it is wired up.
# WHATSAPP_APP_SECRET=

# ─── Timeout Configuration (all values in milliseconds) ───
# CLAW_BASH_TIMEOUT_MS=30000
# CLAW_CODE_EXEC_TIMEOUT_MS=15000
# CLAW_SKILL_INSTALL_TIMEOUT_MS=60000
# CLAW_CHAT_STREAM_TIMEOUT_MS=120000
# CLAW_CHAT_BLOCKING_TIMEOUT_MS=90000
# CLAW_MAX_TOOL_STEPS=15

# ─── Workspace ───
# Root for every file operation, bash command and code execution.
# Default: <project root>/workspace. Also settable per session from
# Settings → Workspace. Read by DEFAULT_WORKSPACE in lib/chat/config.ts.
# CLAW_WORKSPACE_DIR=

# ─── Python Sandbox ───
# Explicit Python 3.14 interpreter path, tried before the Homebrew defaults
# (/opt/homebrew/opt/python@3.14/bin/python3, /usr/local/opt/python@3.14/bin/python3,
# /usr/local/bin/python3). Set this when Node inherits a PATH that differs from
# your shell — the common case for GUI-launched processes on macOS.
# OPENPAW_PYTHON_PATH=

# ─── Memory (Minns) — optional ───
# Without these, the app runs normally minus long-term recall. Also settable from
# Settings → Memory, which persists to .claw/minns-config.json.
# MINNS_API_KEY=
# MINNS_PROJECT_ID=

# ─── Deployment ───
# Used only to build the base URL for cron notification callbacks
# (postCronNotification() in lib/crons/runner.ts).
# VERCEL_URL is supplied automatically by Vercel — listed for reference, do not
# set it yourself. PORT is the self-hosting fallback and defaults to 3000.
# PORT=3000
